<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>TravelListServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.servlet.TravelListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TravelListServlet</servlet-name>
        <url-pattern>/travellist</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <listener>
        <description>ProjectServletContextListener</description>
        <listener-class>hu.pte.mik.prog4.listener.ProjectServletContextListener</listener-class>
    </listener>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>ListenerProtected</web-resource-name>
            <url-pattern>/travelList</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>listener</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>SaverProtected</web-resource-name>
            <url-pattern>/travelSave</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>saver</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Public</web-resource-name>
            <url-pattern>/index.jsp</url-pattern>
            <url-pattern>/login.html</url-pattern>
            <url-pattern>/login_failed.html</url-pattern>
            <url-pattern>/api/*</url-pattern>
        </web-resource-collection>
    </security-constraint>

    <security-role>
        <role-name>listener</role-name>
    </security-role>
    <security-role>
        <role-name>saver</role-name>
    </security-role>


    <login-config>
        <auth-method>FORM</auth-method>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/login_failed.html</form-error-page>
        </form-login-config>
    </login-config>
    <servlet>
        <servlet-name>jersey-servlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>hu.pte.mik.prog4.api</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>jersey-servlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>
</web-app>